# ---------------------------------------------------------------------------
# ParkPunkt environment template
# Copy to .env (or .env.local) and fill in. Never commit a populated file.
# ---------------------------------------------------------------------------

# --- Browser (safe to expose, injected into the client bundle) -------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Server runtime (server functions + server routes only) ----------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Service role key: bypasses row-level security. Server-only.
# Never prefix with VITE_ and never reference it from browser code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Deployment identity and canonical origin ------------------------------
APP_ENV=development
PUBLIC_APP_URL=http://localhost:3000

# --- Payments (Stripe). Use test-mode keys outside production. -------------
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Outbound notification gateway (email/SMS/push adapter) ----------------
NOTIFICATION_DELIVERY_WEBHOOK_URL=
NOTIFICATION_DELIVERY_WEBHOOK_SECRET=

# ISO date of the most recent successful database restore test (YYYY-MM-DD)
BACKUP_VERIFIED_AT=

# ISO date of the most recent staging migration rehearsal (YYYY-MM-DD)
DATABASE_MIGRATIONS_VERIFIED_AT=

# Set only after alerts, dashboards and an incident owner have been tested.
OBSERVABILITY_CONFIGURED=false

# --- Scheduled provider sync ----------------------------------------------
# Cron endpoints under /api/public/cron/* require this bearer token.
# Generate at least 32 random characters (e.g. openssl rand -hex 32).
PARKPUNKT_CRON_SECRET=

# Set after an external scheduler calls both cron endpoints with the bearer secret.
SCHEDULER_CONFIGURED=false

# Separate bearer token for the protected readiness endpoint.
PARKPUNKT_READINESS_SECRET=

# Comma-separated adapters explicitly approved for production sync.
# Leave empty until contracts, parser tests, tariffs and freshness have been verified.
PARKPUNKT_ENABLED_PROVIDER_SLUGS=

# Optional configurable Berlin feed. Must be HTTPS and return canonical { sites: [...] } JSON.
BERLIN_PARKING_FEED_URL=
HAMBURG_PARKING_FEED_URL=

# --- Demo switches. Keep empty/false in production. ------------------------
PARKPUNKT_ENABLE_DEMO_AUTH=false
VITE_ENABLE_DEMO_AUTH=false
PARKPUNKT_ALLOW_FIXTURE_INVENTORY=false

# --- Progressive rollout (UX exposure only; never replaces authorisation) --
VITE_FEATURE_SMART_MAP=false
VITE_FEATURE_FLEET_WORKSPACE=true
VITE_FEATURE_TICKET_SCANNER=false

# --- Registered operator / legal contact details (shown on legal pages) ----
VITE_LEGAL_COMPANY_NAME=
VITE_LEGAL_STREET=
VITE_LEGAL_CITY=
VITE_LEGAL_COUNTRY=Germany
VITE_LEGAL_MANAGING_DIRECTORS=
VITE_LEGAL_REGISTER_COURT=
VITE_LEGAL_REGISTER_NUMBER=
VITE_LEGAL_VAT_ID=
VITE_LEGAL_CONTACT_EMAIL=
VITE_LEGAL_PRIVACY_EMAIL=
VITE_LEGAL_COMPLAINTS_EMAIL=
VITE_LEGAL_DPO=
VITE_LEGAL_ADR_STATEMENT=

# ISO date on which German counsel approved the published legal pages (YYYY-MM-DD).
LEGAL_REVIEWED_AT=
