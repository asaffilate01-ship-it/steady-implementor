# ---------------------------------------------------------------------------
# ParkPunkt environment template
# Copy to .env (or .env.local) and fill in. Never commit a populated file.
# ---------------------------------------------------------------------------

# --- Browser (safe to expose, injected into the client bundle) -------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Server runtime (server functions + server routes only) ----------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Service role key: bypasses row-level security. Server-only.
# Never prefix with VITE_ and never reference it from browser code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Scheduled provider sync ----------------------------------------------
# POST /api/public/cron/sync-providers authenticates the scheduler with
# SUPABASE_PUBLISHABLE_KEY (falls back to VITE_SUPABASE_PUBLISHABLE_KEY).
# Set this to a dedicated 32+ character random secret once the endpoint is
# switched over to a separate scheduler credential.
PARKPUNKT_CRON_SECRET=

# --- Demo switches. Keep empty/false in production. ------------------------
PARKPUNKT_ENABLE_DEMO_AUTH=false
VITE_ENABLE_DEMO_AUTH=false
PARKPUNKT_ALLOW_FIXTURE_INVENTORY=false

# --- Registered operator / legal contact details (shown on legal pages) ----
VITE_LEGAL_COMPANY_NAME=
VITE_LEGAL_STREET=
VITE_LEGAL_CITY=
VITE_LEGAL_COUNTRY=Germany
VITE_LEGAL_MANAGING_DIRECTORS=
VITE_LEGAL_REGISTER_COURT=
VITE_LEGAL_REGISTER_NUMBER=
VITE_LEGAL_VAT_ID=
VITE_LEGAL_CONTACT_EMAIL=
VITE_LEGAL_PRIVACY_EMAIL=
VITE_LEGAL_COMPLAINTS_EMAIL=
VITE_LEGAL_DPO=
VITE_LEGAL_ADR_STATEMENT=