# Supabase client/server configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Deployment identity and canonical origin
APP_ENV=development
PUBLIC_APP_URL=http://localhost:3000

# Stripe (use test-mode credentials locally and live-mode credentials only in production)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Trusted scheduler secret (generate at least 32 random characters)
PARKPUNKT_CRON_SECRET=

# ISO date of the most recent successful database restore test (YYYY-MM-DD)
BACKUP_VERIFIED_AT=

# Trusted outbound notification gateway (email/SMS/push adapter)
NOTIFICATION_DELIVERY_WEBHOOK_URL=
NOTIFICATION_DELIVERY_WEBHOOK_SECRET=

# Demo-only switches. Keep false in every production environment.
PARKPUNKT_ENABLE_DEMO_AUTH=false
VITE_ENABLE_DEMO_AUTH=false
PARKPUNKT_ALLOW_FIXTURE_INVENTORY=false

# Registered operator details used on legal pages
VITE_LEGAL_COMPANY_NAME=
VITE_LEGAL_STREET=
VITE_LEGAL_CITY=
VITE_LEGAL_COUNTRY=Germany
VITE_LEGAL_MANAGING_DIRECTORS=
VITE_LEGAL_REGISTER_COURT=
VITE_LEGAL_REGISTER_NUMBER=
VITE_LEGAL_VAT_ID=
VITE_LEGAL_CONTACT_EMAIL=
VITE_LEGAL_PRIVACY_EMAIL=
VITE_LEGAL_COMPLAINTS_EMAIL=
VITE_LEGAL_DPO=
VITE_LEGAL_ADR_STATEMENT=
